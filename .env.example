# Copy to .env on void-server (git-ignored). No "$" in values, or escape
# as "$$" (Docker Compose interpolates env_file values).

# From ~/infra/platform/.env -> MUNDUS_DB_PASSWORD, after provisioning the
# "mundus" tenant with ~/infra/platform/new-tenant.sh mundus
DATABASE_URL=postgres://mundus_app:REPLACE_WITH_MUNDUS_DB_PASSWORD@postgres:5432/mundus
